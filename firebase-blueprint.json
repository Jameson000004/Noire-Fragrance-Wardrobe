{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "User profile information and settings",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "description": "Unique user identifier matching request.auth.uid"
        },
        "email": {
          "type": "string",
          "format": "email",
          "description": "User email address"
        },
        "displayName": {
          "type": "string",
          "maxLength": 100,
          "description": "User display name"
        },
        "photoURL": {
          "type": "string",
          "description": "User avatar photo URL"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Timestamp when profile was created"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Timestamp when profile was last updated"
        }
      },
      "required": ["userId", "createdAt"]
    },
    "Fragrance": {
      "title": "Fragrance",
      "description": "A luxury fragrance bottle in the user's wardrobe",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique fragrance ID"
        },
        "userId": {
          "type": "string",
          "description": "Owner user ID"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100,
          "description": "Name of the fragrance"
        },
        "brand": {
          "type": "string",
          "maxLength": 100,
          "description": "Brand or maker of the perfume"
        },
        "concentration": {
          "type": "string",
          "enum": ["Parfum", "Eau de Parfum", "Eau de Toilette", "Extrait de Parfum", "Eau de Cologne"],
          "description": "Fragrance concentration"
        },
        "volumeMilliliters": {
          "type": "number",
          "description": "Volume of bottle in milliliters"
        },
        "imageUrl": {
          "type": "string",
          "description": "URL to high-res bottle photo"
        },
        "notes": {
          "type": "object",
          "description": "Olfactory pyramid containing top, heart, base notes"
        },
        "tags": {
          "type": "object",
          "description": "Suitability tags for occasion, time, season, temperature, and sillage"
        },
        "longevityHours": {
          "type": "number",
          "description": "Estimated wear time in hours"
        },
        "longevityText": {
          "type": "string",
          "description": "Human-readable longevity string e.g. 8 h on skin"
        },
        "description": {
          "type": "string",
          "maxLength": 1000,
          "description": "Sensory and editorial description"
        },
        "isFavorite": {
          "type": "boolean",
          "description": "Whether fragrance is starred as a favorite"
        },
        "isArchived": {
          "type": "boolean",
          "description": "Whether fragrance is archived"
        },
        "lastWornAt": {
          "type": "string",
          "format": "date-time",
          "description": "Last timestamp when the user wore this fragrance"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Creation timestamp"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Last updated timestamp"
        }
      },
      "required": ["id", "userId", "name", "createdAt"]
    },
    "WearLog": {
      "title": "WearLog",
      "description": "Historical log of when a fragrance was worn",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique log entry ID"
        },
        "userId": {
          "type": "string",
          "description": "Owner user ID"
        },
        "fragranceId": {
          "type": "string",
          "description": "ID of the fragrance worn"
        },
        "fragranceName": {
          "type": "string",
          "description": "Name of the fragrance worn"
        },
        "wornAt": {
          "type": "string",
          "format": "date-time",
          "description": "Timestamp when fragrance was applied"
        },
        "occasion": {
          "type": "string",
          "description": "Occasion context for wear"
        },
        "weatherSnapshot": {
          "type": "object",
          "description": "Weather conditions snapshot at time of wear"
        },
        "feedback": {
          "type": "string",
          "enum": ["loved", "subtle", "intense"],
          "description": "User reaction or feedback"
        },
        "personalNote": {
          "type": "string",
          "maxLength": 500,
          "description": "Personal wear observation"
        }
      },
      "required": ["id", "userId", "fragranceId", "wornAt"]
    },
    "UserPreferences": {
      "title": "UserPreferences",
      "description": "User settings and defaults",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "description": "Owner user ID"
        },
        "temperatureUnit": {
          "type": "string",
          "enum": ["C", "F"],
          "description": "Preferred temperature unit"
        },
        "defaultOccasion": {
          "type": "string",
          "description": "Default occasion"
        },
        "soundEnabled": {
          "type": "boolean",
          "description": "Whether atomiser sound effects are active"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Last updated timestamp"
        }
      },
      "required": ["userId"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": {
        "$ref": "UserProfile"
      },
      "description": "User profile document storing basic account information"
    },
    "/users/{userId}/fragrances/{fragranceId}": {
      "schema": {
        "$ref": "Fragrance"
      },
      "description": "Personal collection of fragrance flacons owned by the user"
    },
    "/users/{userId}/wearLogs/{wearLogId}": {
      "schema": {
        "$ref": "WearLog"
      },
      "description": "Personal wearing logs and sensory timeline"
    },
    "/users/{userId}/preferences/default": {
      "schema": {
        "$ref": "UserPreferences"
      },
      "description": "User preferences and wardrobe configuration"
    }
  }
}
